# Portfolio environment — copy to .env.local and fill in.
# .env.local is gitignored; this example is the committed reference.

# ---- Supabase (https://supabase.com/dashboard/project/_/settings/api) ----
# Publishable (anon) key — safe for the browser, protected by RLS.
# Without these, the site runs in fallback mode (placeholder projects,
# guestbook/contact return "unconfigured").
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret service-role key — SERVER-SIDE ONLY (Studio admin: guestbook
# moderation, contact inbox in /{fr,en}/studio/admin). Never prefix with
# NEXT_PUBLIC_; never import outside src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Studio (owner passcode) ----
# Passcode for the Studio login (/{fr,en}/studio). Without it, owner
# tools (chat + save_blog_draft, admin) stay disabled.
STUDIO_PASSCODE=

# ---- eve agent model (agent/agent.ts) ----
# NVIDIA NIM key — OpenAI-compatible endpoint (build.nvidia.com) serving
# GLM 5.3. Generate one at https://build.nvidia.com/settings.
# Without it, the eve agent (Studio chat, section regeneration) fails
# and the site falls back to static content.
NVIDIA_API_KEY=
